{
  "name": "ai_battler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx && prettier --check .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix && prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --testTimeout 10000",
    "test:expedition-regression": "vitest run src/core/expedition/regression.test.ts",
    "test:coverage": "vitest run --coverage --testTimeout 10000",
    "update:expedition-regression": "tsx scripts/capture-regression-snapshots.ts && prettier --write regression-snapshots/baseline",
    "phase7-4-memory-smoke": "tsx scripts/phase7-4-memory-smoke.ts",
    "phase7-7-downtime-relationship-smoke": "tsx scripts/phase7-7-downtime-relationship-smoke.ts",
    "phase7-7-1-minor-narrative-diversity-smoke": "tsx scripts/phase7-7-1-minor-narrative-diversity-smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "cssstyle": "~4.1.0"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsx": "^4.22.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
